    "test/types/**/*.d.ts",
    "src/lib/word-composition.ts",
    "src/lib/logical-name-resolution.ts",
    "src/lib/diagram-dictionary-reconciliation.ts",
    "src/lib/dsl-parser.ts",
    "src/lib/ddl-parser.ts",
    "src/lib/dsl-keywords.ts",
    "src/lib/hash.ts",
    "src/lib/table-lock-key.ts",
    "src/types/dictionary.ts",
    "src/types/erd.ts"
