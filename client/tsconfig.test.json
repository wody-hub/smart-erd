{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "outDir": ".tmp-test",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "test/**/*.ts",
    "test/types/**/*.d.ts",
    "src/types/**/*.d.ts"
  ]
}
