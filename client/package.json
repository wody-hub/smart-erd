{
  "name": "smart-erd-client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron-vite dev",
    "build": "tsc -b && vite build",
    "build:electron": "electron-vite build",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "test:unit": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('.tmp-test', { recursive: true, force: true });\" && tsc -p tsconfig.test.json && node --test .tmp-test/test/unit",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke",
    "test:e2e:smoke:collaboration": "playwright test e2e/smoke/diagram-collaboration.spec.ts --browser=chromium --workers=1 --retries=0",
    "test:e2e:recovery": "playwright test e2e/recovery --workers=1",
    "lint": "eslint . && node ../scripts/verify-function-docs.mjs --frontend-only",
    "lint:docs": "node ../scripts/verify-function-docs.mjs --frontend-only",
    "lint:docs:all": "node ../scripts/verify-function-docs.mjs --all --frontend-only",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "perf:erd:apply": "node ./scripts/perf/erd-apply.mjs --scenarios S50,S200,S500 --iterations 15 --warmup 2 --out /tmp/smart-erd/perf/erd-apply-report.json",
    "perf:erd:apply:sample": "node ./scripts/perf/erd-apply.mjs --scenarios S50,S200,S500 --iterations 15 --warmup 2 --out ./perf-reports/erd-apply-report.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.20",
    "@xyflow/react": "^12.0.0",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "electron-store": "^11.0.2",
    "html-to-image": "^1.11.13",
    "i18next": "^25.8.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^4.1.0",
    "lib0": "^0.2.117",
    "lucide-react": "^0.563.0",
    "monaco-editor": "^0.55.1",
    "node-sql-parser": "^5.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hotkeys-hook": "^5.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vite-plugin-monaco-editor": "^1.1.0",
    "yjs": "^13.6.29",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.58.2",
    "@types/dagre": "^0.7.53",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "playwright": "^1.58.2",
    "postcss": "^8.4.49",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.0.0"
  }
}
